{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and personal preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "string" },
        "themeMode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "category", "date", "createdAt", "updatedAt"]
    },
    "Meal": {
      "title": "Meal",
      "description": "Food and nutrition meal entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "calories": { "type": "integer" },
        "mealType": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "protein": { "type": "number" },
        "fat": { "type": "number" },
        "carbs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "calories", "mealType", "date", "createdAt", "updatedAt"]
    },
    "DailyHealth": {
      "title": "DailyHealth",
      "description": "Daily metrics for hydration, activity, and weight",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "waterMl": { "type": "integer" },
        "waterGoalMl": { "type": "integer" },
        "steps": { "type": "integer" },
        "workoutMinutes": { "type": "integer" },
        "caloriesBurned": { "type": "integer" },
        "sleepHours": { "type": "number" },
        "weightKg": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "waterMl", "waterGoalMl", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "User habit tracking definition",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "targetValue": { "type": "integer" },
        "unit": { "type": "string" },
        "frequency": { "type": "string" },
        "icon": { "type": "string" },
        "currentStreak": { "type": "integer" },
        "bestStreak": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "HabitLog": {
      "title": "HabitLog",
      "description": "Daily habit completion record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "value": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "habitId", "date", "completed", "createdAt", "updatedAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Personal target and milestone",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "unit": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "category", "targetValue", "currentValue", "status", "createdAt", "updatedAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Daily reflection, notes and mood log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "mood": { "type": "string" },
        "content": { "type": "string" },
        "highlight": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "mood", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial income and expense transactions"
    },
    "/users/{userId}/meals/{mealId}": {
      "schema": "Meal",
      "description": "Meal nutrition logs"
    },
    "/users/{userId}/dailyHealth/{dateId}": {
      "schema": "DailyHealth",
      "description": "Daily health, hydration, and activity metrics"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "Habit",
      "description": "Tracked user habits"
    },
    "/users/{userId}/habitLogs/{logId}": {
      "schema": "HabitLog",
      "description": "Daily habit logs"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "User progress goals"
    },
    "/users/{userId}/journal/{entryId}": {
      "schema": "JournalEntry",
      "description": "Daily reflections and mood entries"
    }
  }
}
